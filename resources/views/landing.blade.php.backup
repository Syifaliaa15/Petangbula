                <h2>Kalkulator Status Gizi Mandiri</h2>
                <p>Standar Baku Permenkes RI No. 2 Tahun 2020</p>
            </div>

            <div class="tab-nav">
                <button id="btn-tab-balita" class="tab-btn active" onclick="switchTab('balita')">Kalkulator Balita</button>
                <button id="btn-tab-bumil" class="tab-btn" onclick="switchTab('bumil')">Kalkulator Ibu Hamil</button>
            </div>

            <!-- TAB BALITA -->
            <div id="tab-balita" class="tab-content active">
                <div class="form-group">
                    <label for="gender">Jenis Kelamin</label>
                    <select id="gender" class="form-control">
                        <option value="male">Laki-Laki</option>
                        <option value="female">Perempuan</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="umur">Umur (Bulan)</label>
                    <input type="number" id="umur" class="form-control" placeholder="0 - 60" min="0" max="60" required>
                </div>
                <div class="form-group">
                    <label for="bbRiil">Berat Badan (Kg)</label>
                    <input type="number" id="bbRiil" step="0.1" class="form-control" placeholder="Contoh: 8.5" required>
                </div>
                <div class="form-group">
                    <label for="tbRiil">Tinggi / Panjang Badan (Cm)</label>
                    <input type="number" id="tbRiil" step="0.1" class="form-control" placeholder="Contoh: 75.0" required>
                </div>
                <button type="button" class="btn-primary" style="width: 100%; margin-top: 10px;" onclick="hitungGiziBalita()">
                    Hitung Status Gizi Balita
                </button>
                <div id="resultBalita" class="result-container"></div>
            </div>

            <!-- TAB BUMIL -->
            <div id="tab-bumil" class="tab-content">
                <div class="form-group">
                    <label for="tbBumil">Tinggi Badan (cm)</label>
                    <input type="number" id="tbBumil" step="0.1" class="form-control" placeholder="Contoh: 155" required>
                </div>
                <div class="form-group">
                    <label for="bbPra">Berat Badan Sebelum Hamil (kg)</label>
                    <input type="number" id="bbPra" step="0.1" class="form-control" placeholder="Contoh: 50" required>
                </div>
                <div class="form-group">
                    <label for="bbSkrg">Berat Badan Saat Ini (kg)</label>
                    <input type="number" id="bbSkrg" step="0.1" class="form-control" placeholder="Contoh: 55" required>
                </div>
                <div class="form-group">
                    <label for="usiaHamil">Usia Kehamilan (Minggu)</label>
                    <input type="number" id="usiaHamil" min="1" max="42" class="form-control" placeholder="1 - 42 minggu" required>
                </div>
                <hr class="divider">
                <div class="form-group">
                    <label for="lila">LiLA / Lingkar Lengan Atas (cm) <span class="help-text">(Opsional)</span></label>
                    <input type="number" id="lila" step="0.1" class="form-control" placeholder="Contoh: 24">
                </div>
                <div class="form-group">
                    <label for="hb">Hemoglobin / Hb (g/dL) <span class="help-text">(Opsional)</span></label>
                    <input type="number" id="hb" step="0.1" class="form-control" placeholder="Contoh: 11.5">
                </div>
                <button type="button" class="btn-primary" style="width: 100%; margin-top: 10px;" onclick="hitungGiziBumil()">
                    Hitung Status Gizi Ibu Hamil
                </button>
                <div id="resultBumil" class="result-container"></div>
