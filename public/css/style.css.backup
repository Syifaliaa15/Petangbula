/* ==========================================================================
   PETANGBULA - STYLESHEET GLOBAL TEMA PINK
   ========================================================================== */

/* 1. RESET & BASE */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Roboto, sans-serif;
}

html { scroll-behavior: smooth; }

body {
    background: #fff5f8;
    color: #5a2d3e;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-image:
        radial-gradient(circle at 15% 20%, rgba(244, 114, 182, .08), transparent 40%),
        radial-gradient(circle at 85% 80%, rgba(251, 113, 133, .08), transparent 40%);
}

a {
    text-decoration: none;
    color: inherit;
    display: inline-block;
}

/* 2. NAVBAR */
.navbar {
    background: #fff;
    border-bottom: 3px solid #fbcfe8;
    box-shadow: 0 4px 20px rgba(236, 72, 153, .08);
    position: sticky;
    top: 0;
    z-index: 100;
}

.nav-wrap {
    max-width: 1140px;
    margin: 0 auto;
    padding: 12px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.brand-logo {
    height: 60px;
    width: auto;
    object-fit: contain;
}

.btn-login-bubble {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, #ec4899, #f43f5e);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(236, 72, 153, .35);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.btn-login-bubble:hover {
    transform: scale(1.08);
    box-shadow: 0 6px 16px rgba(236, 72, 153, .45);
}

.btn-login-bubble svg {
    width: 24px;
    height: 24px;
    fill: #ffffff;
}

/* 3. HERO SECTION */
.hero-section {
    max-width: 1140px;
    margin: 0 auto;
    padding: 40px 24px 30px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
}

.badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #fce7f3, #fbcfe8);
    color: #be185d;
    padding: 8px 16px;
    border-radius: 24px;
    font-size: .82rem;
    font-weight: 700;
    margin-bottom: 16px;
    border: 1px solid #f9a8d4;
}

.badge .dot {
    width: 8px;
    height: 8px;
    background: #ec4899;
    border-radius: 50%;
    animation: pulse 2s infinite;
}

@keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: .6; transform: scale(1.3); }
}

.hero-title {
    font-size: 2.1rem;
    color: #831843;
    line-height: 1.25;
    margin-bottom: 16px;
    font-weight: 800;
}

.hero-title span {
    background: linear-gradient(135deg, #ec4899, #f43f5e);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.hero-subtitle {
    color: #6b7280;
    line-height: 1.7;
    margin-bottom: 24px;
    font-size: 0.98rem;
}

.hero-btns {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

.btn-primary {
    background: linear-gradient(135deg, #ec4899, #f43f5e);
    color: #fff;
    padding: 14px 26px;
    border-radius: 14px;
    font-weight: 700;
    box-shadow: 0 8px 20px rgba(236, 72, 153, .35);
    border: none;
    cursor: pointer;
    transition: .25s;
    text-align: center;
    font-size: 0.95rem;
}

.btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(236, 72, 153, .45);
}

.btn-secondary {
    background: #6b7280;
    color: #fff;
    padding: 14px 26px;
    border-radius: 14px;
    font-weight: 700;
    border: none;
    cursor: pointer;
    transition: .25s;
    text-align: center;
    font-size: 0.95rem;
}

.btn-secondary:hover {
    background: #4b5563;
    transform: translateY(-3px);
}

.hero-image-wrapper { text-align: center; }

.hero-image {
    max-width: 80%;
    height: auto;
    filter: drop-shadow(0 15px 30px rgba(236, 72, 153, .2));
}

/* 4. INFO GRID */
.info-section {
    max-width: 1140px;
    margin: 30px auto 40px;
    padding: 0 24px;
}

.info-header {
    text-align: center;
    margin-bottom: 30px;
}

.info-header h2 {
    color: #831843;
    font-size: 1.7rem;
    font-weight: 800;
    margin-bottom: 6px;
}

.info-header p {
    color: #6b7280;
    font-size: .95rem;
}

.info-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
}

.info-card {
    background: #fff;
    padding: 20px;
    border-radius: 18px;
    border: 1px solid #fbcfe8;
    box-shadow: 0 4px 16px rgba(236, 72, 153, .06);
    transition: .3s;
    position: relative;
    overflow: hidden;
}

.info-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #f472b6, #ec4899, #f43f5e);
}

.info-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 28px rgba(236, 72, 153, .15);
    border-color: #f472b6;
}

.info-card h3 {
    color: #be185d;
    font-size: 1rem;
    margin-bottom: 8px;
    font-weight: 700;
}

.info-card p {
    font-size: .85rem;
    color: #6b7280;
    line-height: 1.5;
}

/* 5. JADWAL POSYANDU */
.jadwal-section {
    max-width: 1140px;
    margin: 0 auto 50px;
    padding: 0 24px;
}

.jadwal-card {
    background: #fff;
    border-radius: 20px;
    padding: 30px 24px;
    text-align: center;
    border: 2px dashed #fbcfe8;
    box-shadow: 0 8px 24px rgba(236, 72, 153, .05);
}

.jadwal-card h2 {
    color: #831843;
    font-size: 1.6rem;
    font-weight: 800;
    margin-bottom: 12px;
}

.jadwal-empty {
    background: #fff5f8;
    border-radius: 12px;
    padding: 24px;
    color: #9ca3af;
    font-size: 0.92rem;
}

/* 6. KALKULATOR GIZI */
.kalkulator-section {
    max-width: 700px;
    margin: 0 auto 50px;
    padding: 0 24px;
    width: 100%;
}

.kalkulator-card {
    background: #fff;
    border-radius: 20px;
    padding: 28px;
    border: 1px solid #fbcfe8;
    box-shadow: 0 8px 24px rgba(236, 72, 153, .08);
}

.kalkulator-header h2 {
    color: #831843;
    font-size: 1.5rem;
    font-weight: 800;
    text-align: center;
    margin-bottom: 4px;
}

.kalkulator-header p {
    text-align: center;
    font-size: .85rem;
    color: #9ca3af;
    margin-bottom: 24px;
}

.tab-nav {
    display: flex;
    border-bottom: 2px solid #fbcfe8;
    margin-bottom: 24px;
}

.tab-btn {
    flex: 1;
    padding: 12px;
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    font-weight: 700;
    color: #9ca3af;
    cursor: pointer;
    font-size: .95rem;
    transition: .2s;
}

.tab-btn.active {
    color: #be185d;
    border-bottom-color: #ec4899;
}

.tab-content { display: none; }
.tab-content.active { display: block; }

.form-group { margin-bottom: 16px; }

.form-group label {
    display: block;
    font-weight: 700;
    font-size: .85rem;
    color: #831843;
    margin-bottom: 6px;
}

.form-control {
    width: 100%;
    padding: 12px 14px;
    border: 2px solid #fbcfe8;
    border-radius: 12px;
    font-size: .92rem;
    background: #fff5f8;
    outline: none;
    transition: .2s;
    color: #4a1d3a;
}

.form-control:focus {
    border-color: #ec4899;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(236, 72, 153, .12);
}

.help-text {
    font-size: .75rem;
    color: #9ca3af;
    font-weight: normal;
}

.divider {
    border: 0;
    height: 1px;
    background: #fbcfe8;
    margin: 20px 0;
}

/* 7. RESULT BADGE */
.result-container {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.result-card {
    padding: 14px 16px;
    border-radius: 12px;
    border-left: 5px solid #9ca3af;
    background: #fff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, .03);
}

.result-card h4 {
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: .5px;
    margin-bottom: 4px;
    color: #6b7280;
    font-weight: 700;
}

.result-card p { font-size: .92rem; font-weight: 600; }

.result-card.success { background: #f0fdf4; border-left-color: #22c55e; color: #15803d; }
.result-card.warning { background: #fefce8; border-left-color: #eab308; color: #a16207; }
.result-card.danger  { background: #fef2f2; border-left-color: #ef4444; color: #b91c1c; }
.result-card.info    { background: #eff6ff; border-left-color: #3b82f6; color: #1d4ed8; }

/* 8. FOOTER */
.footer {
    background: linear-gradient(135deg, #831843, #9d174d);
    color: #fce7f3;
    text-align: center;
    padding: 24px 20px;
    margin-top: auto;
    font-size: .88rem;
}

/* 9. RESPONSIVE */
@media (min-width: 900px) {
    .hero-section { grid-template-columns: 1.1fr 1fr; padding: 60px 24px 40px; }
    .hero-title { font-size: 2.4rem; }
    .kalkulator-card { padding: 36px; }
}

@media (max-width: 899px) and (min-width: 601px) {
    .info-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 600px) {
    .nav-wrap { padding: 10px 16px; }
    .brand-logo { height: 36px; }
    .btn-login-bubble { width: 38px; height: 38px; }
    .btn-login-bubble svg { width: 20px; height: 20px; }
    .hero-title { font-size: 1.7rem; }
    .hero-subtitle { font-size: 0.9rem; }
    .btn-primary { width: 100%; text-align: center; }
    .info-grid { grid-template-columns: 1fr; }
    .kalkulator-card { padding: 20px 16px; }
    .tab-btn { font-size: 0.85rem; padding: 10px 4px; }
}